        "#INPUT / OUTPUT\n",
        "\n",
        "# Basic print\n",
        "print(\"Hello\")                    # Hello\n",
        "\n",
        "# Print multiple values — separated by space by default\n",
        "print(\"Hello\", \"Divya\")           # Hello Divya\n",
        "\n",
        "# Change separator using sep parameter\n",
        "print(\"Hello\", \"Divya\", sep=\"-\")  # Hello-Divya\n",
        "print(1, 2, 3, sep=\", \")          # 1, 2, 3\n",
        "\n",
        "# Change ending using end parameter (default is newline \\n)\n",
        "print(\"Hello\", end=\" \")\n",
        "print(\"World\")                    # Hello World  ← on same line!\n",
        "\n",
        "# Print empty line\n",
        "print()                           # just a blank line\n",
        "\n",
        "# Print with tab\n",
        "print(\"Name\", \"Age\", sep=\"\\t\")    # Name    Age"
